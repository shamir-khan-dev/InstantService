# InstantService Backend Environment Variables
# Copy this file to '.env' and fill in your actual API keys

# === Core Settings ===
# MOCK_MODE=true runs the full booking flow in-memory (no Snowflake required)
MOCK_MODE=true
DEMO_MODE=true

# === Developer 3: AI & Voice ===
GEMINI_API_KEY="your_gemini_api_key_here"
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# === Developer 4: Database (Snowflake) ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=INSTANTSERVICE_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Comma-separated list. Add your Vercel URL here before deploying the backend.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
